<%- include('../partials/header', { user }) %>
<div class="container-fluid mt-4">
  <h2>Customers <a href="/customers/create" class="btn btn-primary btn-sm">Add Customer</a></h2>
  <table class="table table-striped">
    <thead><tr><th>Name</th><th>Phone</th><th>Email</th><th>ID Number</th><th>Blacklisted</th><th>Actions</th></tr></thead>
    <tbody>
      <% customers.forEach(c => { %>
        <tr>
          <td><%= c.getFullName() %></td>
          <td><%= c.phone %></td>
          <td><%= c.email || 'N/A' %></td>
          <td><%= c.id_number %></td>
          <td><span class="badge bg-<%= c.is_blacklisted ? 'danger' : 'success' %>"><%= c.is_blacklisted ? 'Yes' : 'No' %></span></td>
          <td>
            <% if (user.role === 'admin' || user.role === 'receptionist') { %>
              <% if (c.is_blacklisted) { %>
                <form action="/customers/<%= c.customer_id %>/unblacklist" method="POST" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-success">Unblacklist</button>
                </form>
              <% } else { %>
                <form action="/customers/<%= c.customer_id %>/blacklist" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to blacklist this customer?');">
                  <button type="submit" class="btn btn-sm btn-warning">Blacklist</button>
                </form>
              <% } %>
              <form action="/customers/<%= c.customer_id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this customer?');">
                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>