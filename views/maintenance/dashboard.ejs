<%- include('../partials/header', { user }) %>
<div class="container-fluid mt-4">
  <h2>Maintenance Dashboard</h2>
  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="row">
    <div class="col-md-12 mb-4">
      <div class="card border-warning">
        <div class="card-header bg-warning">Pending Maintenance Tasks</div>
        <div class="card-body p-0">
          <table class="table table-striped mb-0">
            <thead>
              <tr>
                <th>Vehicle</th>
                <th>Service Type</th>
                <th>Scheduled</th>
                <th>Priority</th>
                <th>Status</th>
                <th>Complete &amp; Return Vehicle</th>
              </tr>
            </thead>
            <tbody>
              <% if (pendingSchedules && pendingSchedules.length > 0) { %>
                <% pendingSchedules.forEach(s => { %>
                  <tr>
                    <td>
                      <%= s.vehicle ? s.vehicle.registration : 'N/A' %>
                      <% if (s.vehicle) { %><br><small class="text-muted"><%= s.vehicle.make %> <%= s.vehicle.model %></small><% } %>
                    </td>
                    <td><%= s.service_type.replace(/_/g, ' ') %></td>
                    <td><%= s.scheduled_date ? new Date(s.scheduled_date).toLocaleDateString() : 'N/A' %></td>
                    <td><span class="badge bg-<%= s.priority === 'high' ? 'danger' : s.priority === 'medium' ? 'warning' : 'secondary' %>"><%= s.priority %></span></td>
                    <td><span class="badge bg-info"><%= s.status %></span></td>
                    <td>
                      <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#completeModal<%= s.schedule_id %>">
                        Complete &amp; Set Available
                      </button>
                    </td>
                  </tr>

                  <div class="modal fade" id="completeModal<%= s.schedule_id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <form action="/maintenance/<%= s.schedule_id %>/complete" method="POST">
                          <div class="modal-header">
                            <h5 class="modal-title">Complete Maintenance — <%= s.vehicle ? s.vehicle.registration : '' %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <p class="text-muted small">Completing this task will mark the vehicle as <strong>available</strong> for rental.</p>
                            <div class="mb-3">
                              <label class="form-label">Description</label>
                              <textarea name="description" class="form-control" rows="2" required><%= s.service_type.replace(/_/g, ' ') %> completed</textarea>
                            </div>
                            <div class="mb-3">
                              <label class="form-label">Service Provider</label>
                              <input type="text" name="provider" class="form-control" value="In-house" required>
                            </div>
                            <div class="row">
                              <div class="col-md-6 mb-3">
                                <label class="form-label">Cost (KES)</label>
                                <input type="number" name="cost" class="form-control" min="0" step="0.01" value="0" required>
                              </div>
                              <div class="col-md-6 mb-3">
                                <label class="form-label">Mileage (km)</label>
                                <input type="number" name="mileage" class="form-control" min="0" value="<%= s.vehicle ? s.vehicle.current_mileage : 0 %>">
                              </div>
                            </div>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-success">Complete &amp; Return to Fleet</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% }) %>
              <% } else { %>
                <tr><td colspan="6" class="text-center">No pending maintenance tasks</td></tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header">Recent Maintenance Records</div>
    <div class="card-body p-0">
      <table class="table table-striped mb-0">
        <thead><tr><th>Vehicle</th><th>Date</th><th>Type</th><th>Cost</th><th>Provider</th><th>Description</th></tr></thead>
        <tbody>
          <% if (maintenanceRecords && maintenanceRecords.length > 0) { %>
            <% maintenanceRecords.forEach(m => { %>
              <tr>
                <td><%= m.vehicle ? m.vehicle.registration : 'N/A' %></td>
                <td><%= m.service_date ? new Date(m.service_date).toLocaleDateString() : 'N/A' %></td>
                <td><%= m.service_type %></td>
                <td>KES <%= (m.cost || 0).toLocaleString() %></td>
                <td><%= m.provider || 'N/A' %></td>
                <td><%= m.description || 'N/A' %></td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr><td colspan="6" class="text-center">No maintenance records found</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
