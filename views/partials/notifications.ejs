<!-- Notifications Widget -->
<% if (typeof notifications !== 'undefined' && notifications.alerts && notifications.alerts.length > 0) { %>
<div class="row mb-4">
  <div class="col-12">
    <div class="card border-primary">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">🔔 Notifications</h5>
        <span class="badge bg-light text-dark"><%= notifications.alerts.length %></span>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% notifications.alerts.forEach(function(alert) { %>
            <a href="<%= alert.link %>" class="list-group-item list-group-item-action list-group-item-<%= alert.type %>">
              <div class="d-flex w-100 justify-content-between align-items-center">
                <div>
                  <span style="font-size: 1.5em; margin-right: 10px;"><%= alert.icon %></span>
                  <strong><%= alert.message %></strong>
                </div>
                <% if (alert.priority === 'high') { %>
                  <span class="badge bg-danger">High Priority</span>
                <% } else if (alert.priority === 'medium') { %>
                  <span class="badge bg-warning text-dark">Medium</span>
                <% } %>
              </div>
            </a>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Recent Activity Section for Admin -->
<% if (typeof notifications !== 'undefined' && notifications.systemActivities && notifications.systemActivities.length > 0 && user.role === 'admin') { %>
<div class="row mb-4">
  <div class="col-12">
    <div class="card">
      <div class="card-header bg-dark text-white">
        <h5 class="mb-0">📊 Recent System Activities (Last 24 Hours)</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Time</th>
                <th>Action</th>
                <th>Description</th>
                <th>Performed By</th>
                <th>Role</th>
              </tr>
            </thead>
            <tbody>
              <% notifications.systemActivities.slice(0, 10).forEach(function(activity) { %>
                <tr <%= activity.isNew ? 'class="table-info"' : '' %>>
                  <td><small><%= new Date(activity.timestamp).toLocaleTimeString() %></small></td>
                  <td><%= activity.icon %> <%= activity.action %></td>
                  <td><%= activity.description %></td>
                  <td><%= activity.performedBy %></td>
                  <td><span class="badge bg-secondary"><%= activity.performedByRole %></span></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Self-Service Bookings for Receptionist/Admin -->
<% if (typeof notifications !== 'undefined' && notifications.recentBookings && notifications.recentBookings.length > 0 && ['admin', 'receptionist'].includes(user.role)) { %>
<div class="row mb-4">
  <div class="col-12">
    <div class="card border-success">
      <div class="card-header bg-success text-white">
        <h5 class="mb-0">🚗 Self-Service Bookings (Customer-Made)</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Reference</th>
                <th>Customer</th>
                <th>Vehicle</th>
                <th>Start Date</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody>
              <% notifications.recentBookings.forEach(function(booking) { %>
                <tr <%= booking.isNew ? 'class="table-success"' : '' %>>
                  <td><strong><%= booking.reference %></strong></td>
                  <td>
                    <%= booking.customer %><br>
                    <small class="text-muted"><%= booking.customerPhone %></small>
                  </td>
                  <td><small><%= booking.vehicle %></small></td>
                  <td><%= new Date(booking.startDate).toLocaleDateString() %></td>
                  <td>KES <%= parseFloat(booking.totalAmount).toLocaleString() %></td>
                  <td><span class="badge bg-<%= booking.status === 'confirmed' ? 'primary' : 'secondary' %>"><%= booking.status %></span></td>
                  <td><a href="/bookings" class="btn btn-sm btn-outline-primary">Review</a></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Recent Cancellations -->
<% if (typeof notifications !== 'undefined' && notifications.cancellations && notifications.cancellations.length > 0 && ['admin', 'receptionist'].includes(user.role)) { %>
<div class="row mb-4">
  <div class="col-12">
    <div class="card border-warning">
      <div class="card-header bg-warning">
        <h5 class="mb-0">❌ Recent Booking Cancellations</h5>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush">
          <% notifications.cancellations.forEach(function(cancellation) { %>
            <div class="list-group-item">
              <div class="d-flex w-100 justify-content-between">
                <div>
                  <strong><%= cancellation.description %></strong><br>
                  <small class="text-muted">
                    Cancelled by: <%= cancellation.cancelledBy %> 
                    (<%= cancellation.cancelledByRole %>)
                    <% if (cancellation.isSelfCancelled) { %>
                      <span class="badge bg-info">Self-Cancelled</span>
                    <% } %>
                  </small>
                </div>
                <small class="text-muted"><%= new Date(cancellation.cancelledAt).toLocaleString() %></small>
              </div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>
  </div>
</div>
<% } %>

<!-- Department Activities for Admin -->
<% if (typeof notifications !== 'undefined' && notifications.departmentActivities && Object.keys(notifications.departmentActivities).length > 0 && user.role === 'admin') { %>
<div class="row mb-4">
  <div class="col-12">
    <h4>Department Activities (Last 24 Hours)</h4>
  </div>
  <% Object.keys(notifications.departmentActivities).forEach(function(dept) { 
    const deptData = notifications.departmentActivities[dept];
  %>
    <div class="col-md-4 mb-3">
      <div class="card">
        <div class="card-header bg-secondary text-white">
          <h6 class="mb-0"><%= deptData.name %></h6>
        </div>
        <div class="card-body">
          <p class="mb-2"><strong><%= deptData.count %></strong> activities</p>
          <% if (deptData.activities.length > 0) { %>
            <ul class="list-unstyled small">
              <% deptData.activities.slice(0, 3).forEach(function(activity) { %>
                <li class="mb-1">
                  • <%= activity.description.substring(0, 50) %>...
                  <br><small class="text-muted"><%= activity.performedBy %></small>
                </li>
              <% }); %>
            </ul>
          <% } else { %>
            <p class="text-muted small">No recent activities</p>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>
</div>
<% } %>
