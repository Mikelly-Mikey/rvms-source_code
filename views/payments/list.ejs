<%- include('../partials/header', { user }) %>
<div class="container-fluid mt-4">
  <h2>Payments</h2>

  <!-- Record Payment Form -->
  <div class="card mb-4">
    <div class="card-header bg-success text-white">
      <h5 class="mb-0">Record New Payment</h5>
    </div>
    <div class="card-body">
      <form method="POST" action="/payments/record" class="row g-3">
        <div class="col-md-3">
          <label class="form-label">Booking Reference</label>
          <input type="number" name="booking_id" class="form-control" placeholder="Booking ID" required>
        </div>
        <div class="col-md-2">
          <label class="form-label">Amount (KES)</label>
          <input type="number" name="amount" class="form-control" placeholder="Amount" min="0.01" step="0.01" required>
        </div>
        <div class="col-md-2">
          <label class="form-label">Method</label>
          <select name="method" class="form-select" required>
            <option value="cash">Cash</option>
            <option value="mpesa">M-Pesa</option>
            <option value="bank_transfer">Bank Transfer</option>
            <option value="card">Card</option>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label">Reference</label>
          <input type="text" name="reference" class="form-control" placeholder="e.g. M-Pesa code">
        </div>
        <div class="col-md-2">
          <label class="form-label">Notes</label>
          <input type="text" name="notes" class="form-control" placeholder="Optional notes">
        </div>
        <div class="col-md-1 d-flex align-items-end">
          <button type="submit" class="btn btn-success w-100">Record</button>
        </div>
      </form>
    </div>
  </div>

  <!-- M-Pesa STK Push -->
  <div class="card mb-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
      <h5 class="mb-0">Pay via M-Pesa (Safaricom STK Push)</h5>
      <small class="opacity-75">Prompts the customer's phone for their M-Pesa PIN</small>
    </div>
    <div class="card-body">
      <form id="mpesa-form" class="row g-3">
        <div class="col-md-3">
          <label class="form-label">Booking ID</label>
          <input type="number" id="mpesa-booking" class="form-control" placeholder="Booking ID" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Phone Number</label>
          <input type="text" id="mpesa-phone" class="form-control" placeholder="07XXXXXXXX" required>
        </div>
        <div class="col-md-3">
          <label class="form-label">Amount (KES)</label>
          <input type="number" id="mpesa-amount" class="form-control" placeholder="Amount" min="1" step="1" required>
        </div>
        <div class="col-md-3 d-flex align-items-end">
          <button type="submit" id="mpesa-btn" class="btn btn-dark w-100">Send STK Push</button>
        </div>
      </form>
      <div id="mpesa-status" class="mt-3" style="display:none;">
        <div class="alert mb-0" role="alert"></div>
      </div>
    </div>
  </div>

  <!-- Payment History Table -->
  <table class="table table-striped">
    <thead><tr><th>Booking Ref</th><th>Amount</th><th>Method</th><th>Reference</th><th>Booking Total</th><th>Total Paid</th><th>Balance Due</th><th>Status</th><th>Date</th></tr></thead>
    <tbody>
      <% if (payments && payments.length > 0) { %>
        <% payments.forEach(p => { %>
          <tr>
            <td><%= p.booking ? p.booking.booking_reference : 'N/A' %></td>
            <td>KES <%= (p.amount || 0).toLocaleString() %></td>
            <td><%= p.method %></td>
            <td><%= p.reference || '-' %></td>
            <td><%= p.booking ? 'KES ' + (p.booking.total_amount || 0).toLocaleString() : 'N/A' %></td>
            <td><%= p.booking ? 'KES ' + (p.booking.deposit_paid || 0).toLocaleString() : 'N/A' %></td>
            <td><span class="<%= p.booking && parseFloat(p.booking.balance_due || 0) > 0 ? 'text-danger fw-bold' : 'text-success' %>"><%= p.booking ? 'KES ' + (p.booking.balance_due || 0).toLocaleString() : 'N/A' %></span></td>
            <td><span class="badge bg-<%= p.status === 'completed' ? 'success' : 'warning' %>"><%= p.status %></span></td>
            <td><%= p.payment_date ? new Date(p.payment_date).toISOString().slice(0,10) : 'N/A' %></td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr><td colspan="9" class="text-center">No payments found</td></tr>
      <% } %>
    </tbody>
  </table>
</div>

<script>
(function () {
  const form = document.getElementById('mpesa-form');
  if (!form) return;
  const btn = document.getElementById('mpesa-btn');
  const statusBox = document.getElementById('mpesa-status');
  const alertEl = statusBox.querySelector('.alert');
  let pollTimer = null;

  function showStatus(type, msg) {
    statusBox.style.display = 'block';
    alertEl.className = 'alert alert-' + type + ' mb-0';
    alertEl.innerHTML = msg;
  }

  function resetButton() {
    btn.disabled = false;
    btn.textContent = 'Send STK Push';
  }

  function pollStatus(checkoutRequestId, attempt) {
    attempt = attempt || 0;
    if (attempt > 20) {
      showStatus('warning', 'Timed out waiting for confirmation. Check payment history.');
      resetButton();
      return;
    }
    fetch('/payments/mpesa/status/' + encodeURIComponent(checkoutRequestId))
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) {
          showStatus('danger', data.message || 'Could not check status.');
          resetButton();
          return;
        }
        if (data.status === 'completed') {
          showStatus('success',
            'Payment confirmed! M-Pesa receipt: <strong>' + (data.receipt || '') +
            '</strong>. Reloading...');
          setTimeout(function () { window.location.reload(); }, 1500);
          return;
        }
        if (data.status === 'failed' || data.status === 'cancelled') {
          showStatus('danger', 'Payment ' + data.status + ': ' + (data.resultDesc || ''));
          resetButton();
          return;
        }
        pollTimer = setTimeout(function () {
          pollStatus(checkoutRequestId, attempt + 1);
        }, 2000);
      })
      .catch(function () {
        pollTimer = setTimeout(function () {
          pollStatus(checkoutRequestId, attempt + 1);
        }, 2000);
      });
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    if (pollTimer) clearTimeout(pollTimer);
    btn.disabled = true;
    btn.textContent = 'Sending...';
    showStatus('info', 'Sending STK push to the customer\'s phone...');

    const payload = {
      booking_id: document.getElementById('mpesa-booking').value,
      phone: document.getElementById('mpesa-phone').value,
      amount: document.getElementById('mpesa-amount').value
    };

    fetch('/payments/mpesa/stkpush', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data.success) {
          showStatus('danger', data.message || 'Failed to start M-Pesa payment.');
          resetButton();
          return;
        }
        const note = data.simulated ? ' <span class="badge bg-secondary">simulation</span>' : '';
        showStatus('info', (data.message || 'STK push sent.') + note +
          ' Waiting for the customer to enter their PIN...');
        pollStatus(data.checkoutRequestId, 0);
      })
      .catch(function () {
        showStatus('danger', 'Network error starting M-Pesa payment.');
        resetButton();
      });
  });
})();
</script>
<%- include('../partials/footer') %>