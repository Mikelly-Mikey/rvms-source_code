<%- include('../partials/header', { user }) %>
<div class="container-fluid mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Staff Management</h2>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addStaffModal">Add Personnel</button>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="alert alert-success alert-dismissible fade show">
      <%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show">
      <%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
  <% } %>

  <div class="card mb-4">
    <div class="card-header bg-primary text-white">
      <h5 class="mb-0">Company Personnel</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Username</th>
              <th>Full Name</th>
              <th>Role</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Active</th>
              <th>Joined</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(u => { %>
                <tr>
                  <td><strong><%= u.username %></strong></td>
                  <td><%= u.getFullName() %></td>
                  <td>
                    <span class="badge bg-<%= u.role === 'admin' ? 'danger' : u.role === 'fleet_supervisor' ? 'primary' : u.role === 'receptionist' ? 'info' : 'secondary' %>">
                      <%= u.role.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                    </span>
                  </td>
                  <td><%= u.email %></td>
                  <td><%= u.phone || 'N/A' %></td>
                  <td>
                    <% if (u.is_active) { %>
                      <span class="badge bg-success">Active</span>
                    <% } else { %>
                      <span class="badge bg-secondary">Inactive</span>
                    <% } %>
                  </td>
                  <td><%= u.date_joined ? new Date(u.date_joined).toLocaleDateString() : 'N/A' %></td>
                  <td>
                    <% if (u.id !== user.id) { %>
                      <form action="/users/<%= u.id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Remove <%= u.getFullName() %> from staff? This action cannot be undone.');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                          <i class="bi bi-trash"></i> Delete
                        </button>
                      </form>
                    <% } else { %>
                      <span class="badge bg-warning text-dark">You</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="8" class="text-center py-4">
                  <p class="text-muted mb-0">No staff members found</p>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

<!-- Add Staff Modal -->
<div class="modal fade" id="addStaffModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <form action="/users/create" method="POST">
        <div class="modal-header bg-primary text-white">
          <h5 class="modal-title">Add New Personnel</h5>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">First Name <span class="text-danger">*</span></label>
              <input type="text" name="first_name" class="form-control" value="<%= typeof formData !== 'undefined' && formData ? formData.first_name || '' : '' %>" required>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Last Name <span class="text-danger">*</span></label>
              <input type="text" name="last_name" class="form-control" value="<%= typeof formData !== 'undefined' && formData ? formData.last_name || '' : '' %>" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Username <span class="text-danger">*</span></label>
              <input type="text" name="username" class="form-control" value="<%= typeof formData !== 'undefined' && formData ? formData.username || '' : '' %>" minlength="3" required>
              <small class="text-muted">At least 3 characters</small>
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Email <span class="text-danger">*</span></label>
              <input type="email" name="email" class="form-control" value="<%= typeof formData !== 'undefined' && formData ? formData.email || '' : '' %>" required>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Phone</label>
              <input type="text" name="phone" class="form-control" value="<%= typeof formData !== 'undefined' && formData ? formData.phone || '' : '' %>" placeholder="+254...">
            </div>
            <div class="col-md-6 mb-3">
              <label class="form-label">Role <span class="text-danger">*</span></label>
              <select name="role" class="form-select" required>
                <option value="">Select role...</option>
                <option value="fleet_supervisor" <%= typeof formData !== 'undefined' && formData && formData.role === 'fleet_supervisor' ? 'selected' : '' %>>Fleet Supervisor</option>
                <option value="receptionist" <%= typeof formData !== 'undefined' && formData && formData.role === 'receptionist' ? 'selected' : '' %>>Receptionist</option>
                <option value="mechanic" <%= typeof formData !== 'undefined' && formData && formData.role === 'mechanic' ? 'selected' : '' %>>Mechanic</option>
                <option value="admin" <%= typeof formData !== 'undefined' && formData && formData.role === 'admin' ? 'selected' : '' %>>Admin</option>
              </select>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label">Password <span class="text-danger">*</span></label>
            <input type="password" name="password" class="form-control" minlength="6" required>
            <small class="text-muted">At least 6 characters</small>
          </div>
          <div class="alert alert-info mb-0">
            <strong>Note:</strong> The new staff member will be able to log in immediately with the provided credentials.
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Add Personnel</button>
        </div>
      </form>
    </div>
  </div>
</div>

<% if (typeof error !== 'undefined' && error && typeof formData !== 'undefined' && formData) { %>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    var modal = new bootstrap.Modal(document.getElementById('addStaffModal'));
    modal.show();
  });
</script>
<% } %>

<%- include('../partials/footer') %>
