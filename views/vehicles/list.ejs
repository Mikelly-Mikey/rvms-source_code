<%- include('../partials/header', { user }) %>
<div class="container-fluid mt-4">
  <h2>Vehicles <% if (user && (user.role === 'admin' || user.role === 'fleet_supervisor')) { %><a href="/vehicles/create" class="btn btn-primary btn-sm">Add Vehicle</a><% } %></h2>
  <table class="table table-striped">
    <thead><tr><th>Image</th><th>Reg</th><th>Make/Model</th><th>Year</th><th>Category</th><th>Rate/day</th><th>Status</th><th>Actions</th></tr></thead>
    <tbody>
      <% vehicles.forEach(v => { %>
        <tr>
          <td>
            <% if (v.image_url) { %>
              <img src="<%= v.image_url %>" alt="<%= v.registration %>" style="width: 60px; height: 40px; object-fit: cover;">
            <% } else { %>
              <span class="text-muted">No image</span>
            <% } %>
          </td>
          <td><%= v.registration %></td>
          <td><%= v.make %> <%= v.model %></td>
          <td><%= v.year %></td>
          <td><%= v.category %></td>
          <td>KES <%= parseFloat(v.daily_rate).toLocaleString() %></td>
          <td><span class="badge bg-<%= v.status === 'available' ? 'success' : v.status === 'on-rent' ? 'info' : 'secondary' %>"><%= v.status %></span></td>
          <% if (user && user.role !== 'customer') { %>
            <td>
              <a href="/vehicles/<%= v.vehicle_id %>" class="btn btn-sm btn-outline-primary">View</a>
              <% if (user.role === 'admin' || user.role === 'fleet_supervisor') { %>
                <% if (v.status !== 'on-rent' && v.status !== 'reserved') { %>
                  <form action="/vehicles/<%= v.vehicle_id %>/delete" method="POST" style="display:inline;" onsubmit="return confirm('Are you sure you want to delete this vehicle?');">
                    <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                  </form>
                <% } %>
              <% } %>
            </td>
          <% } else { %>
            <td></td>
          <% } %>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>
<%- include('../partials/footer') %>