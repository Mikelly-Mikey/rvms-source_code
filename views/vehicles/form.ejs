<%- include('../partials/header', { user }) %>
<div class="container mt-4">
  <h2>Add New Vehicle</h2>
  <form method="POST" action="/vehicles/create">
    <div class="row">
      <div class="col-md-4 mb-3"><label>Registration</label><input type="text" name="registration" class="form-control" required></div>
      <div class="col-md-4 mb-3"><label>Make</label><input type="text" name="make" class="form-control" required></div>
      <div class="col-md-4 mb-3"><label>Model</label><input type="text" name="model" class="form-control" required></div>
    </div>
    <div class="row">
      <div class="col-md-3 mb-3"><label>Year</label><input type="number" name="year" class="form-control" required></div>
      <div class="col-md-3 mb-3"><label>Color</label><input type="text" name="color" class="form-control" required></div>
      <div class="col-md-3 mb-3">
        <label>Fuel Type</label>
        <select name="fuel_type" class="form-select">
          <option value="petrol">Petrol</option><option value="diesel">Diesel</option><option value="electric">Electric</option><option value="hybrid">Hybrid</option>
        </select>
      </div>
      <div class="col-md-3 mb-3">
        <label>Transmission</label>
        <select name="transmission" class="form-select">
          <option value="manual">Manual</option><option value="automatic">Automatic</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="col-md-3 mb-3"><label>Seats</label><input type="number" name="seating_capacity" class="form-control" value="5"></div>
      <div class="col-md-3 mb-3">
        <label>Category</label>
        <select name="category" class="form-select">
          <option value="economy">Economy</option><option value="compact">Compact</option><option value="suv">SUV</option><option value="luxury">Luxury</option>
        </select>
      </div>
      <div class="col-md-3 mb-3"><label>Daily Rate (KES)</label><input type="number" step="0.01" name="daily_rate" class="form-control" required></div>
      <div class="col-md-3 mb-3"><label>Status</label>
        <select name="status" class="form-select">
          <option value="available">Available</option><option value="maintenance">Maintenance</option><option value="offline">Offline</option>
        </select>
      </div>
    </div>
    <div class="row">
      <div class="col-md-12 mb-3"><label>Image URL</label><input type="url" name="image_url" class="form-control" placeholder="https://example.com/vehicle-image.jpg"></div>
    </div>
    <button type="submit" class="btn btn-primary">Save Vehicle</button>
    <a href="/vehicles" class="btn btn-secondary">Cancel</a>
  </form>
</div>
<%- include('../partials/footer') %>